// Sample rows for the Sentinel rules in infra/sentinel/rules. Times are
// minutes before now, so the rows are always in the rules' windows.
// To run a rule in a workspace (docs/real-vault-checklist.md, "Sentinel:
// rules on the sample rows"): paste this file, then the `lets` of the rule's
// case in cases.json, then the rule's .kql file, and run. The row count
// must match the case's `rows`. The `let` of KeyringAudit_CL below stands in
// for the table, so nothing is written to the workspace.
// tests/sentinel.rs checks these columns against src/audit/sink.rs.
let KeyringRows = datatable(MinutesAgo:int, Action:string, Outcome:string, ReasonCode:string,
    ActorObjectId:string, ActorUpn:string, ClientIp:string, UserAgent:string,
    Vault:string, ItemKind:string, ItemName:string, KvRequestId:string,
    SharePrincipalId:string, SharePrincipalType:string)
