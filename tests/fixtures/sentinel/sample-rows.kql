// Key Vault's log, already in the shape of infra/sentinel/rules/keyvault-*.kql.
let KeyVaultRows = datatable(MinutesAgo:int, ResourceId:string, OperationName:string, Item:string,
    CallerIpAddress:string, CorrelationId:string, CallerObjectId:string)
[
    // Matched by request ID (Alex's reveal, kv-1).
    90, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-one", "SecretGet", "db-password", "203.0.113.10", "kv-1", "a1",
    // No ID match, but Alex rolled back db-old a minute later (kv-3).
    95, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-one", "SecretGet", "db-old", "203.0.113.10", "kv-2", "a1",
    // No Keyring event at all: the one the rule finds.
    100, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-two", "SecretGet", "smtp", "203.0.113.10", "kv-4", "x9",
    // Not from Keyring's address.
    100, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-two", "SecretGet", "smtp", "198.51.100.200", "kv-5", "x9",
    // Too recent for the unmatched rule.
    30, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-one", "SecretGet", "db-password", "203.0.113.10", "kv-6", "x9",
    // A list call, which no audited action makes on its own.
    30, "/subscriptions/s/resourcegroups/r/providers/microsoft.keyvault/vaults/kv-three", "SecretList", "", "203.0.113.10", "kv-7", "a1",
]
| extend TimeGenerated = ago(MinutesAgo * 1m)
| project-away MinutesAgo;
