g: notification flows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="notify-002" value="Every email leaves through one sender and one Azure Communication Services resource, as Keyring's managed identity." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="notify-003" value='&lt;b&gt;Expiry, pushed by Event Grid&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;notify type expiry&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#fcf1ef;strokeColor=#e8ada7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="330" as="geometry"/></mxCell><mxCell id="notify-004" value='&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Near expiry, expired&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="35" y="130" width="180" height="64" as="geometry"/></mxCell><mxCell id="notify-005" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="44" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="notify-006" value='&lt;b&gt;Event Grid&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;System topic&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="245" y="130" width="180" height="64" as="geometry"/></mxCell><mxCell id="notify-007" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Event_Grid_Topics.svg;" vertex="1" parent="1"><mxGeometry x="254" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="notify-008" value='&lt;b&gt;Subscription&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Entra auth, header&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;keyring-notify&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="245" y="220" width="180" height="80" as="geometry"/></mxCell><mxCell id="notify-009" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Event_Grid_Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="254" y="242" width="36" height="36" as="geometry"/></mxCell><mxCell id="notify-010" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="notify-004" target="notify-006"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-011" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-006" target="notify-008"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-012" value='&lt;b&gt;Six events&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;SecretNearExpiry&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;SecretExpired&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;KeyNearExpiry&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;KeyExpired&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;CertificateNearExpiry&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;CertificateExpired&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="35" y="220" width="195" height="175" as="geometry"/></mxCell><mxCell id="notify-013" value="&lt;b&gt;Raised by people's actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#515963&quot;&gt;Fixed text and checked names; never a value&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#e3f4f8;strokeColor=#9ac7d2;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="400" height="350" as="geometry"/></mxCell><mxCell id="notify-014" value='&lt;b&gt;Access request (access-requests)&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:10.5px"&gt;POST /v/{vault}/my-access/request. To keyring-owners&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:10.5px"&gt;or the admins; a separate copy to the requester.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:10.5px"&gt;One per person, vault and role an hour&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="35" y="480" width="370" height="80" as="geometry"/></mxCell><mxCell id="notify-015" value="&lt;b&gt;Activity (watched-reads, destructive, role-use)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;A second audit observer, on successful events only.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;Watched reads: the item's notify (and owner) tags,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;4 an hour per item. Deletes, purges, bulk changes,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;role use: keyring-owners, read as the person, or admins&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="35" y="572" width="370" height="92" as="geometry"/></mxCell><mxCell id="notify-016" value="&lt;b&gt;Secret shared (shares)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;With KEYRING_SHARING=true, after share.grant.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;To the recipient's Graph mail (groups get none)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:10.5px&quot;&gt;and a receipt to the sharer&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="35" y="676" width="370" height="90" as="geometry"/></mxCell><mxCell id="notify-017" value="&lt;b&gt;Keyring&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="470" y="80" width="450" height="700" as="geometry"/></mxCell><mxCell id="notify-018" value="&lt;b&gt;POST /hooks/eventgrid&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Entra token: RS256, issuer, audience, tenant, expiry,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Event Grid's app ID, the subscriber app role, app-only.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;1 MB, 1 to 50 events, topic a Key Vault ID, subscription&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;in KEYRING_EVENTGRID_SUBSCRIPTIONS when set. Dedupe 24 h.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="485" y="130" width="410" height="110" as="geometry"/></mxCell><mxCell id="notify-019" value="Entra token" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b02a2d;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-008" target="notify-018"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="260"/><mxPoint x="450" y="185"/></Array></mxGeometry></mxCell><mxCell id="notify-020" value='&lt;b&gt;Health notices (timer, every 30 seconds)&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audit sink degraded for 5 minutes, and recovered.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Refusal burst: over KEYRING_NOTIFY_BURST_THRESHOLD refused&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;or denied events from one person or IP in 15 minutes.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Client secret expiry: 30, 14, 7 and 1 days, and passed.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="485" y="255" width="410" height="110" as="geometry"/></mxCell><mxCell id="notify-021" value='&lt;b&gt;Audit observer&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Counts refused and denied events as they are written&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="485" y="380" width="410" height="64" as="geometry"/></mxCell><mxCell id="notify-022" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-021" target="notify-020"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-023" value='&lt;b&gt;Sender (src/notify/sender.rs)&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Strict address parsing, KEYRING_NOTIFY_ALLOWED_DOMAINS,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;KEYRING_NOTIFY_RATE_PER_HOUR per mailbox per type.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Queue of 1,000, retries with Retry-After, one Repeatability-&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Request-Id per email, given up after five minutes.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;One notify.sent or notify.failed audit event per email.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="485" y="470" width="410" height="140" as="geometry"/></mxCell><mxCell id="notify-024" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-018" target="notify-023"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="912" y="218"/><mxPoint x="912" y="540"/></Array></mxGeometry></mxCell><mxCell id="notify-025" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-020" target="notify-023"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="903" y="310"/><mxPoint x="903" y="505"/></Array></mxGeometry></mxCell><mxCell id="notify-026" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-014" target="notify-023"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="520"/><mxPoint x="430" y="505"/></Array></mxGeometry></mxCell><mxCell id="notify-027" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-015" target="notify-023"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="618"/><mxPoint x="445" y="540"/></Array></mxGeometry></mxCell><mxCell id="notify-028" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-016" target="notify-023"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="721"/><mxPoint x="460" y="575"/></Array></mxGeometry></mxCell><mxCell id="notify-029" value='&lt;b&gt;What an email holds&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Fixed subject: [Keyring], the type, the item.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Fixed text, checked names, counts, dates, reason codes,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;links built by Keyring. Outside text cleaned, alone in a&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;labelled field. Never a value, token, private key, Azure&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;message or a typed reason (an access request quotes one&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;only when no mail client could turn it into a link).&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="485" y="630" width="410" height="135" as="geometry"/></mxCell><mxCell id="notify-030" value="&lt;b&gt;Out&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#fdf2dd;strokeColor=#dcb783;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="430" height="700" as="geometry"/></mxCell><mxCell id="notify-031" value='&lt;b&gt;Managed identity token&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audience https://communication.azure.com&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="130" width="400" height="70" as="geometry"/></mxCell><mxCell id="notify-032" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="974" y="147" width="36" height="36" as="geometry"/></mxCell><mxCell id="notify-033" value='&lt;b&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;POST /emails:send?api-version=2025-09-01&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Custom role: Read and Write on this resource&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="230" width="400" height="80" as="geometry"/></mxCell><mxCell id="notify-034" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="974" y="252" width="36" height="36" as="geometry"/></mxCell><mxCell id="notify-035" value='&lt;b&gt;Recipients&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;To addresses only. No cc or bcc. Tracking off&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="340" width="400" height="70" as="geometry"/></mxCell><mxCell id="notify-036" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-031" target="notify-033"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-037" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-033" target="notify-035"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-038" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="notify-023" target="notify-033"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="575"/><mxPoint x="935" y="270"/></Array></mxGeometry></mxCell><mxCell id="notify-039" value='&lt;b&gt;Health of email itself&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;/healthz/notify: ok, degraded or off, with counts.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;503 while sending has failed for a minute.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;A failing sender is logged once per incident&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;and never emailed about.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="440" width="400" height="150" as="geometry"/></mxCell><mxCell id="notify-040" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="620" width="400" height="122" as="geometry"/></mxCell><mxCell id="notify-041" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="977" y="658" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-042" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1017" y="658" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-043" value="" style="html=1;strokeColor=#186575;strokeWidth=2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="notify-041" target="notify-042"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-044" value="The person's OBO token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1025" y="649" width="334" height="18" as="geometry"/></mxCell><mxCell id="notify-045" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="977" y="680" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-046" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1017" y="680" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-047" value="" style="html=1;strokeColor=#804d0c;strokeWidth=2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="notify-045" target="notify-046"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-048" value="Keyring's identity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1025" y="671" width="334" height="18" as="geometry"/></mxCell><mxCell id="notify-049" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="977" y="702" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-050" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1017" y="702" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-051" value="" style="html=1;strokeColor=#b02a2d;strokeWidth=2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="notify-049" target="notify-050"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-052" value="Event Grid delivery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1025" y="693" width="334" height="18" as="geometry"/></mxCell><mxCell id="notify-053" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="977" y="724" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-054" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1017" y="724" width="1" height="1" as="geometry"/></mxCell><mxCell id="notify-055" value="" style="html=1;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="notify-053" target="notify-054"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notify-056" value="Browser and other" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1025" y="715" width="334" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deploy" name="5 Deployment"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="deploy-001" value="&lt;b&gt;Keyring: deployment&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="deploy-002" value="Bicep in infra/. Two hosting paths share the same modules. Nothing in the repository deploys by itself." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="deploy-003" value="&lt;b&gt;Keyring's resource group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#515963&quot;&gt;az deployment group create, run by the deployer&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="900" height="760" as="geometry"/></mxCell><mxCell id="deploy-004" value='&lt;b&gt;App Service path&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;infra/app-service/main.bicep&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="420" height="330" as="geometry"/></mxCell><mxCell id="deploy-005" value='&lt;b&gt;App Service plan&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;-plan, default P0v3&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="55" y="180" width="390" height="64" as="geometry"/></mxCell><mxCell id="deploy-006" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Service_Plans.svg;" vertex="1" parent="1"><mxGeometry x="64" y="194" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-007" value='&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;, HTTPS only, /healthz probe, port 3000&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="55" y="254" width="390" height="64" as="geometry"/></mxCell><mxCell id="deploy-008" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="64" y="268" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-009" value='&lt;b&gt;Options&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;vnetIntegrationSubnetId (route all) for private vaults&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;inboundPrivateEndpointSubnetId for private ingress&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;logAnalyticsWorkspaceId for console and HTTP logs&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;useManagedIdentityForRegistry for a private ACR&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="55" y="328" width="390" height="118" as="geometry"/></mxCell><mxCell id="deploy-010" value='&lt;b&gt;Container Apps path&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;infra/container-apps/main.bicep&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="420" height="330" as="geometry"/></mxCell><mxCell id="deploy-011" value='&lt;b&gt;Log Analytics workspace&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;-logs, console logs&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="495" y="180" width="390" height="64" as="geometry"/></mxCell><mxCell id="deploy-012" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="504" y="194" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-013" value='&lt;b&gt;Container Apps environment&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;-env, external or internal&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="495" y="254" width="390" height="64" as="geometry"/></mxCell><mxCell id="deploy-014" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="504" y="268" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-015" value='&lt;b&gt;Container app&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;, sticky sessions above 1 replica&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="495" y="328" width="390" height="64" as="geometry"/></mxCell><mxCell id="deploy-016" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="504" y="342" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-017" value='&lt;font color="#1c222a" style="font-size:11.5px"&gt;Two runs: configOnly=true first, then the app&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="495" y="402" width="390" height="44" as="geometry"/></mxCell><mxCell id="deploy-018" value='&lt;b&gt;Shared modules (both paths)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;infra/modules&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="860" height="140" as="geometry"/></mxCell><mxCell id="deploy-019" value='&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;-id, user-assigned&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="55" y="530" width="270" height="74" as="geometry"/></mxCell><mxCell id="deploy-020" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="64" y="549" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-021" value='&lt;b&gt;Config vault&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;config-vault.bicep: RBAC, soft&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;delete, purge protection&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="270" height="74" as="geometry"/></mxCell><mxCell id="deploy-022" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="349" y="549" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-023" value='&lt;b&gt;Private endpoints, DNS&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;private-endpoint.bicep,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;private-dns.bicep&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="625" y="530" width="260" height="74" as="geometry"/></mxCell><mxCell id="deploy-024" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="634" y="549" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-025" value="&lt;b&gt;Optional, by parameter&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="860" height="185" as="geometry"/></mxCell><mxCell id="deploy-026" value='&lt;b&gt;Audit sink: auditWorkspaceId&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;audit-sink.bicep: KeyringAudit_CL,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Direct rule, Monitoring Metrics&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Publisher on the rule&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="270" height="120" as="geometry"/></mxCell><mxCell id="deploy-027" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Data_Collection_Rules.svg;" vertex="1" parent="1"><mxGeometry x="64" y="732" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-028" value='&lt;b&gt;Email: notifyDomain&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;notify.bicep: Email service and&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;domain, &amp;lt;name&amp;gt;-acs, custom role&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Keyring email sender (&amp;lt;name&amp;gt;)&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="270" height="120" as="geometry"/></mxCell><mxCell id="deploy-029" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="349" y="732" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-030" value='&lt;b&gt;useFederatedCredential&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;The app registration trusts&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;&amp;lt;name&amp;gt;-id. No client secret&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;in the config vault&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="625" y="690" width="260" height="120" as="geometry"/></mxCell><mxCell id="deploy-031" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="634" y="732" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-032" value='&lt;b&gt;Separate deployments&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Run against other scopes when wanted&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="430" height="760" as="geometry"/></mxCell><mxCell id="deploy-033" value="&lt;b&gt;Expiry alerts: infra/alerts/main.bicep&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;expiry-events.bicep: system topic and&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;subscription per vault, to an action&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;group or (notifyVia = 'keyring') the webhook&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="130" width="400" height="110" as="geometry"/></mxCell><mxCell id="deploy-034" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Event_Grid_Topics.svg;" vertex="1" parent="1"><mxGeometry x="974" y="167" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-035" value="&lt;b&gt;Access alerts: infra/alerts/access.bicep&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Log search alerts on the vault's workspace:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;watched reads, purges, refusals. Run as&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Azure Monitor's own identity&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="255" width="400" height="100" as="geometry"/></mxCell><mxCell id="deploy-036" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="974" y="287" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-037" value='&lt;b&gt;Sentinel: infra/sentinel/main.bicep&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;ASIM parsers, analytic rules (created off),&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;hunting queries and a workbook for&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;KeyringAudit_CL&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="370" width="400" height="110" as="geometry"/></mxCell><mxCell id="deploy-038" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Azure_Sentinel.svg;" vertex="1" parent="1"><mxGeometry x="974" y="407" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-039" value='&lt;b&gt;Private DNS: infra/modules/private-dns.bicep&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;privatelink.vaultcore.azure.net zone and&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;VNet link, run on its own&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="495" width="400" height="100" as="geometry"/></mxCell><mxCell id="deploy-040" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="974" y="527" width="36" height="36" as="geometry"/></mxCell><mxCell id="deploy-041" value='&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Every app setting is listed in the template, so a setting&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;added by hand is removed by the next deployment.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Secrets are set after deployment with az keyvault secret&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;set, never in a template or parameter file.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;CI runs az bicep build on every template and example&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;parameter file. CI deploys nothing.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="965" y="610" width="400" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="controls" name="6 Security controls"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="controls-001" value="&lt;b&gt;Keyring: security controls overlay&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="controls-002" value="C-numbers match the controls table in chapter 8. Each badge sits where the control is enforced." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="controls-003" value='&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Session ID cookie only&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="230" height="80" as="geometry"/></mxCell><mxCell id="controls-004" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Browser.svg;" vertex="1" parent="1"><mxGeometry x="29" y="152" width="36" height="36" as="geometry"/></mxCell><mxCell id="controls-005" value="&lt;b&gt;C4&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="222" y="116" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-006" value="&lt;b&gt;C21&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="116" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-007" value="&lt;b&gt;Keyring&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="560" height="780" as="geometry"/></mxCell><mxCell id="controls-008" value='&lt;b&gt;Request edge&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Header timeout, body limits, 90 s limit, 512 connections, security headers&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="130" width="530" height="70" as="geometry"/></mxCell><mxCell id="controls-009" value="&lt;b&gt;C18&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="116" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-010" value="&lt;b&gt;C6&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="116" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-011" value='&lt;b&gt;Sign-in and sessions&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;OIDC with PKCE, state, nonce.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;In-memory sessions, timeouts&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="215" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-012" value="&lt;b&gt;C3&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="201" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-013" value="&lt;b&gt;C4&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="505" y="201" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-014" value='&lt;b&gt;Form guards&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Origin check and form token&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;bound to the vault&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="575" y="215" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-015" value="&lt;b&gt;C5&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="201" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-016" value="&lt;b&gt;Gates before any Azure call&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Typed name and purge off, step-up, reason, password policy, owner rule,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;reveal limit, audit required, input checked against Key Vault's rules&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="320" width="530" height="90" as="geometry"/></mxCell><mxCell id="controls-017" value="&lt;b&gt;C9&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-018" value="&lt;b&gt;C10&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-019" value="&lt;b&gt;C11&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="743" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-020" value="&lt;b&gt;C16&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="711" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-021" value="&lt;b&gt;C7&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="679" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-022" value="&lt;b&gt;C23&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="647" y="306" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-023" value="&lt;b&gt;Azure clients&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Person's OBO token on every data&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;call, shares included. Azure decides&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="425" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-024" value="&lt;b&gt;C1&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="411" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-025" value="&lt;b&gt;C22&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="505" y="411" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-026" value="&lt;b&gt;C26&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="473" y="411" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-027" value='&lt;b&gt;Outbound HTTP client&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;rustls and ring, HTTPS only,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;no redirects, fixed hosts&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="575" y="425" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-028" value="&lt;b&gt;C17&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="411" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-029" value='&lt;b&gt;Secret handling&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Secret and AccessToken print&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;[redacted], zeroised, never logged&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="530" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-030" value="&lt;b&gt;C8&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="516" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-031" value='&lt;b&gt;Audit events&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;One per audited request,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;coverage tested&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="575" y="530" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-032" value="&lt;b&gt;C12&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="516" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-033" value="&lt;b&gt;C13&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="516" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-034" value='&lt;b&gt;Event Grid webhook&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Entra token checked first,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;topic check, limits, dedupe&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="635" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-035" value="&lt;b&gt;C15&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="621" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-036" value='&lt;b&gt;Email sender&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Allow-list, rate limit, fixed content;&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;request and activity limits&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="575" y="635" width="260" height="90" as="geometry"/></mxCell><mxCell id="controls-037" value="&lt;b&gt;C14&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="621" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-038" value="&lt;b&gt;C24&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="621" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-039" value="&lt;b&gt;C25&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="743" y="621" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-040" value='&lt;b&gt;Build and runtime&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Distroless static image, non-root, read-only, no capabilities.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;forbid(unsafe_code), cargo deny and cargo audit, pinned toolchain and actions, SBOM.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="740" width="530" height="100" as="geometry"/></mxCell><mxCell id="controls-041" value="&lt;b&gt;C19&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="807" y="826" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-042" value="&lt;b&gt;C20&lt;/b&gt;" style="ellipse;html=1;fillColor=#186575;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="826" width="28" height="28" as="geometry"/></mxCell><mxCell id="controls-043" value="&lt;b&gt;Microsoft cloud&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;stro