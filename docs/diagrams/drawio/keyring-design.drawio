<mxfile host="build_drawio.py" agent="Keyring diagram generator" version="1" compressed="false"><diagram id="logical" name="1 Logical architecture"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="logical-001" value="&lt;b&gt;Keyring: logical architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="logical-002" value="One stateless web app in front of Azure Key Vault. Every call that reads or changes a person's data is made as that person." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="logical-003" value='&lt;b&gt;People&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Browser only holds a session ID&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="360" as="geometry"/></mxCell><mxCell id="logical-004" value='&lt;b&gt;People&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Staff who use Key Vault&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="32" y="130" width="206" height="60" as="geometry"/></mxCell><mxCell id="logical-005" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="41" y="142" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-006" value='&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;HTML, CSS, a few small&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;same-origin scripts&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="32" y="220" width="206" height="70" as="geometry"/></mxCell><mxCell id="logical-007" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Browser.svg;" vertex="1" parent="1"><mxGeometry x="41" y="237" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-008" value='&lt;b&gt;Kept in the browser&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Session cookie (random ID)&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Pinned and recent names&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;(localStorage, keyring.pins)&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Nothing else&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="32" y="310" width="206" height="116" as="geometry"/></mxCell><mxCell id="logical-009" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="logical-004" target="logical-006"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="logical-010" value='&lt;b&gt;Inbound&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;No session: an Entra token instead&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#fcf1ef;strokeColor=#e8ada7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="230" height="130" as="geometry"/></mxCell><mxCell id="logical-011" value='&lt;b&gt;Azure Event Grid&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Key Vault expiry events&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e8ada7;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="32" y="520" width="206" height="64" as="geometry"/></mxCell><mxCell id="logical-012" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Event_Grid_Topics.svg;" vertex="1" parent="1"><mxGeometry x="41" y="534" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-013" value='&lt;b&gt;Keyring&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Rust, Axum and Askama, one container&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="470" height="790" as="geometry"/></mxCell><mxCell id="logical-014" value='&lt;b&gt;Web server and routes&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/routes: pages, forms, CSV, /healthz, /hooks/eventgrid&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="130" width="440" height="70" as="geometry"/></mxCell><mxCell id="logical-015" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="314" y="147" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-016" value='&lt;b&gt;Guards before any Azure call&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Origin, form token, typed name,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;step-up, reason, policy, owner&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;rule, reveal limit, audit required&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="215" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-017" value='&lt;b&gt;Sign-in and sessions&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/auth: OIDC with PKCE,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;in-memory sessions, step-up,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Event Grid token check&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="530" y="215" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-018" value='&lt;b&gt;Audit events&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/audit: one event per&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;audited request, to stdout&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;and the optional sink&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="322" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-019" value='&lt;b&gt;Azure clients&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/azure: Key Vault, ARM, PIM,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Resource Graph, Log Analytics,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Graph. All as the person&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="530" y="322" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-020" value='&lt;b&gt;Email sender&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/notify: queue, rate limit;&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;health, expiry, access request,&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;activity and share notices&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="429" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-021" value='&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;src/auth/assertion.rs:&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;one identity, three uses&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fdf2dd;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="530" y="429" width="215" height="92" as="geometry"/></mxCell><mxCell id="logical-022" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="539" y="457" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-023" value="&lt;b&gt;What Keyring holds&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Per session, in memory only: the person's tokens, exchanged tokens per&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;resource, each vault's item list for 60 seconds, permission hints for&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;5 minutes, a pending upload or import for 10 minutes.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;No database, no disk, no cache shared between sessions.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Secret values pass through memory on the way to the browser&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;and are never logged, cached or written down.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;A restart signs everyone out.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="305" y="536" width="440" height="200" as="geometry"/></mxCell><mxCell id="logical-024" value="HTTPS" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="logical-006" target="logical-014"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="262" y="255"/><mxPoint x="262" y="165"/></Array></mxGeometry></mxCell><mxCell id="logical-025" value="webhook" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b02a2d;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="logical-011" target="logical-014"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="276" y="552"/><mxPoint x="276" y="189"/></Array></mxGeometry></mxCell><mxCell id="logical-026" value='&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;One tenant&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="580" height="260" as="geometry"/></mxCell><mxCell id="logical-027" value='&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Sign-in, OBO, Conditional Access&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="815" y="130" width="270" height="64" as="geometry"/></mxCell><mxCell id="logical-028" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="824" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-029" value='&lt;b&gt;App registration&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Delegated permissions only&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1095" y="130" width="270" height="64" as="geometry"/></mxCell><mxCell id="logical-030" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/App_Registrations.svg;" vertex="1" parent="1"><mxGeometry x="1104" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-031" value='&lt;b&gt;Entra PIM for Azure resources&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Read and requested through ARM&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="815" y="230" width="270" height="64" as="geometry"/></mxCell><mxCell id="logical-032" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Entra_Privileged_Identity_Management.svg;" vertex="1" parent="1"><mxGeometry x="824" y="244" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-033" value='&lt;b&gt;Conditional Access&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Authentication context for step-up&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1095" y="230" width="270" height="64" as="geometry"/></mxCell><mxCell id="logical-034" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Conditional_Access.svg;" vertex="1" parent="1"><mxGeometry x="1104" y="244" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-035" value="&lt;b&gt;Azure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#515963&quot;&gt;People's subscriptions, plus Keyring's own resource group&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="580" height="510" as="geometry"/></mxCell><mxCell id="logical-036" value="&lt;b&gt;Called as the signed-in person&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#e3f4f8;strokeColor=#9ac7d2;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="815" y="410" width="550" height="236" as="geometry"/></mxCell><mxCell id="logical-037" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;People's vaults, data plane&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="830" y="440" width="260" height="56" as="geometry"/></mxCell><mxCell id="logical-038" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="839" y="450" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-039" value='&lt;b&gt;Azure Resource Manager&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Settings, roles, PIM&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1095" y="440" width="255" height="56" as="geometry"/></mxCell><mxCell id="logical-040" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1104" y="450" width="36" height="36" as="geometry"/></mxCell><mxCell id="logical-041" value='&lt;b&gt;Azure Resource Graph&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Vault discovery, vault owners&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="830" y="506" width="260" height="56" as="geometry"/><