tryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="logical-021" target="logical-029"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="457"/><mxPoint x="795" y="318"/><mxPoint x="1374" y="318"/><mxPoint x="1374" y="162"/></Array></mxGeometry></mxCell><mxCell id="logical-074" value="audit rows, email" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="logical-021" target="logical-048"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="503"/><mxPoint x="785" y="721"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="identity" name="2 Identity and token flows"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="identity-001" value="&lt;b&gt;Keyring: identity and token flows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="identity-002" value="Left: the person's tokens, used for every read or change of their data. Right: Keyring's one managed identity and its three uses." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="identity-003" value='&lt;b&gt;As the signed-in person&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Delegated permissions, on-behalf-of (OBO)&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#e3f4f8;strokeColor=#9ac7d2;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="680" height="760" as="geometry"/></mxCell><mxCell id="identity-004" value='&lt;b&gt;Person&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Signs in with Entra ID&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-005" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="49" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-006" value='&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Holds a session ID only&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-007" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Browser.svg;" vertex="1" parent="1"><mxGeometry x="49" y="244" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-008" value='&lt;b&gt;Keyring&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Server-side session&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-009" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="289" y="244" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-010" value='&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;login.microsoftonline.com&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-011" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="489" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-012" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-004" target="identity-006"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="identity-013" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="identity-006" target="identity-008"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="identity-014" value="1. Code + PKCE" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-008" target="identity-010"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="162"/></Array></mxGeometry></mxCell><mxCell id="identity-015" value="&lt;b&gt;1. Sign-in&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;Authorisation code flow with PKCE (S256), state and nonce. Scopes: openid, profile, offline_access&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;and Keyring's own API scope (api://&amp;amp;lt;client ID&amp;amp;gt;/access_as_user, or ENTRA_API_SCOPE).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;The ID token is checked (signature, issuer, audience, expiry, nonce). The access token for Keyring's API&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;and the refresh token stay in the server's memory. Step-up adds acrs claims or prompt=login with max_age.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="640" height="120" as="geometry"/></mxCell><mxCell id="identity-016" value='&lt;b&gt;2. On-behalf-of exchange, per resource, cached per session until 5 minutes before expiry&lt;/b&gt;&lt;br&gt;&lt;font color="#1c222a" style="font-size:11.5px"&gt;https://vault.azure.net/.default           Key Vault data plane&lt;/font&gt;&lt;br&gt;&lt;font color="#1c222a" style="font-size:11.5px"&gt;https://management.azure.com/.default   ARM and Resource Graph (roles, PIM, diagnostic settings)&lt;/font&gt;&lt;br&gt;&lt;font color="#1c222a" style="font-size:11.5px"&gt;https://api.loganalytics.io/.default       Log Analytics queries (audit pages, Used by, Keyring activity)&lt;/font&gt;&lt;br&gt;&lt;font color="#1c222a" style="font-size:11.5px"&gt;Grant: urn:ietf:params:oauth:grant-type:jwt-bearer with requested_token_use=on_behalf_of.&lt;/font&gt;&lt;br&gt;&lt;font color="#1c222a" style="font-size:11.5px"&gt;Keyring authenticates the exchange with its client secret or the federated credential (right).&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="640" height="150" as="geometry"/></mxCell><mxCell id="identity-017" value='&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;As the person&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-018" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="49" y="644" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-019" value='&lt;b&gt;ARM and Resource Graph&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;As the person&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="260" y="630" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-020" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1"><mxGeometry x="269" y="644" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-021" value='&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;As the person&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="480" y="630" width="200" height="64" as="geometry"/></mxCell><mxCell id="identity-022" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="489" y="644" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-023" value="&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:12px&quot;&gt;No client-credentials grant, app-only token or managed identity is ever used on this side.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:12px&quot;&gt;Key Vault RBAC (or access policies) decides every request. Keyring's permission hints only grey out buttons.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:12px&quot;&gt;PIM activation is a PUT to roleAssignmentScheduleRequests with the person's ARM token.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="640" height="110" as="geometry"/></mxCell><mxCell id="identity-024" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-008" target="identity-017"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="262"/><mxPoint x="690" y="615"/><mxPoint x="140" y="615"/></Array></mxGeometry></mxCell><mxCell id="identity-025" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-008" target="identity-019"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="262"/><mxPoint x="690" y="615"/><mxPoint x="360" y="615"/></Array></mxGeometry></mxCell><mxCell id="identity-026" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-008" target="identity-021"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="262"/><mxPoint x="690" y="615"/><mxPoint x="580" y="615"/></Array></mxGeometry></mxCell><mxCell id="identity-027" value="&lt;b&gt;As Keyring's managed identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#515963&quot;&gt;One user-assigned identity: KEYRING_MANAGED_IDENTITY_CLIENT_ID&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#fdf2dd;strokeColor=#dcb783;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="660" height="760" as="geometry"/></mxCell><mxCell id="identity-028" value='&lt;b&gt;Keyring&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Asks the local token service&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="220" height="64" as="geometry"/></mxCell><mxCell id="identity-029" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="749" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-030" value='&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;IDENTITY_ENDPOINT on localhost or 169.254.0.0/16&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="360" height="64" as="geometry"/></mxCell><mxCell id="identity-031" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="1009" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-032" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="identity-028" target="identity-030"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="identity-033" value='&lt;b&gt;1. Federated credential (optional, replaces the client secret)&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audience api://AzureADTokenExchange, sent to Entra as client_assertion&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;on sign-in, refresh and OBO. Never sent with a client secret.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="740" y="240" width="620" height="90" as="geometry"/></mxCell><mxCell id="identity-034" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="749" y="267" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-035" value="&lt;b&gt;2. Audit sink (optional)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Audience https://monitor.azure.com. Writes Keyring's audit events through one&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;data collection rule. Role: Monitoring Metrics Publisher on that rule only.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="620" height="90" as="geometry"/></mxCell><mxCell id="identity-036" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Data_Collection_Rules.svg;" vertex="1" parent="1"><mxGeometry x="749" y="377" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-037" value='&lt;b&gt;3. Email (optional)&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audience https://communication.azure.com. POST /emails:send on one resource.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Role: custom, CommunicationServices/Read and /Write on that resource, assigned directly.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="740" y="460" width="620" height="90" as="geometry"/></mxCell><mxCell id="identity-038" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="749" y="487" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-039" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-030" target="identity-033"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1372" y="162"/><mxPoint x="1372" y="285"/></Array></mxGeometry></mxCell><mxCell id="identity-040" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-030" target="identity-035"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1372" y="162"/><mxPoint x="1372" y="395"/></Array></mxGeometry></mxCell><mxCell id="identity-041" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="identity-030" target="identity-037"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1372" y="162"/><mxPoint x="1372" y="505"/></Array></mxGeometry></mxCell><mxCell id="identity-042" value="&lt;b&gt;Platform only: Keyring's own config vault&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;App Service or Container Apps resolves Key Vault references at start. Role: Key Vault&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;Secrets User on the config vault (client secret, session secret). Keyring's code never calls it.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="740" y="570" width="620" height="80" as="geometry"/></mxCell><mxCell id="identity-043" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="749" y="592" width="36" height="36" as="geometry"/></mxCell><mxCell id="identity-044" value="&lt;b&gt;What the identity does not have&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;No role on any vault people use, on Resource Graph, or on any workspace's data.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;It never reads KeyringAudit_CL: the audit page reads it as the person.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;No access key, connection string, SMTP password or second identity.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;The app registration holds delegated permissions only, so the federated credential gives&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;no vault access while nobody is signed in. Adding an application permission is a security change.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="740" y="665" width="620" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="network" name="3 Network and data flows"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="network-001" value="&lt;b&gt;Keyring: network and data flows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1360" height="28" as="geometry"/></mxCell><mxCell id="network-002" value="All traffic is HTTPS on port 443. Private vaults need Keyring inside a network that reaches their private endpoints." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#515963;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1360" height="20" as="geometry"/></mxCell><mxCell id="network-003" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;People's network&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="network-004" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Browser.svg;" vertex="1" parent="1"><mxGeometry x="29" y="157" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-005" value='&lt;b&gt;Azure Event Grid&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Delivers to the public&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;address only&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e8ada7;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="200" height="70" as="geometry"/></mxCell><mxCell id="network-006" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Event_Grid_Topics.svg;" vertex="1" parent="1"><mxGeometry x="29" y="437" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-007" value='&lt;b&gt;Azure virtual network (optional)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Needed for private vaults and internal ingress&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="640" height="640" as="geometry"/></mxCell><mxCell id="network-008" value='&lt;b&gt;Keyring subnet&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Delegated to Microsoft.Web or Microsoft.App&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="300" height="300" as="geometry"/></mxCell><mxCell id="network-009" value='&lt;b&gt;Keyring&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;App Service with VNet integration&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;or a Container Apps environment&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="295" y="190" width="270" height="80" as="geometry"/></mxCell><mxCell id="network-010" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="304" y="212" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-011" value='&lt;b&gt;Ingress&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Public, HTTPS only, or private:&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;internal Container Apps or an&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;App Service private endpoint.&lt;/font&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;The webhook needs it public.&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="295" y="285" width="215" height="130" as="geometry"/></mxCell><mxCell id="network-012" value="&lt;b&gt;Private endpoint subnet&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="270" height="300" as="geometry"/></mxCell><mxCell id="network-013" value='&lt;b&gt;Private endpoint&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;One per private vault&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="625" y="240" width="240" height="64" as="geometry"/></mxCell><mxCell id="network-014" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="634" y="254" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-015" value="&lt;b&gt;Private DNS zone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;privatelink.vaultcore.azure.net&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#515963&quot; style=&quot;font-size:11.5px&quot;&gt;linked to Keyring's VNet&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="625" y="330" width="240" height="80" as="geometry"/></mxCell><mxCell id="network-016" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="634" y="352" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-017" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-013"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="network-018" value="name lookup" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#515963;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;dashed=1;dashPattern=8 5;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-015"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="network-019" value='&lt;b&gt;Private Key Vault&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Public access off&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="625" y="460" width="240" height="70" as="geometry"/></mxCell><mxCell id="network-020" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="634" y="477" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-021" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-013" target="network-019"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="272"/><mxPoint x="890" y="495"/></Array></mxGeometry></mxCell><mxCell id="network-022" value='&lt;b&gt;Keyring config vault&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Optional private endpoint&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="295" y="460" width="270" height="70" as="geometry"/></mxCell><mxCell id="network-023" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="304" y="477" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-024" value="platform only" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#dcb783;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;dashed=1;dashPattern=8 5;exitX=0.9;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-022"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="network-025" value="&lt;b&gt;What crosses the network&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;Browser to Keyring: pages, forms and one revealed value at a time, with Cache-Control: no-store.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;Keyring to Azure: the person's OBO token on every data call; Keyring's identity token only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;for the federated credential, the audit sink and email. TLS through rustls with the ring provider,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;operating system roots or SSL_CERT_FILE. No redirects followed, no plain HTTP except localhost.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1c222a&quot; style=&quot;font-size:11.5px&quot;&gt;Outbound proxies: HTTPS_PROXY and NO_PROXY are honoured; the local token service never uses one.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="600" height="145" as="geometry"/></mxCell><mxCell id="network-026" value='&lt;b&gt;Public Azure endpoints (port 443)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#515963"&gt;Reached directly or through the egress path&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#737b84;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="440" height="780" as="geometry"/></mxCell><mxCell id="network-027" value='&lt;b&gt;login.microsoftonline.com&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Sign-in, refresh, OBO, metadata, keys&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="400" height="64" as="geometry"/></mxCell><mxCell id="network-028" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="969" y="144" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-029" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-027"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="206"/><mxPoint x="920" y="162"/></Array></mxGeometry></mxCell><mxCell id="network-030" value='&lt;b&gt;management.azure.com&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;ARM and Resource Graph&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="400" height="64" as="geometry"/></mxCell><mxCell id="network-031" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1"><mxGeometry x="969" y="224" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-032" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-030"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="206"/><mxPoint x="920" y="242"/></Array></mxGeometry></mxCell><mxCell id="network-033" value='&lt;b&gt;api.loganalytics.io&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audit queries as the person&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="400" height="64" as="geometry"/></mxCell><mxCell id="network-034" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="969" y="304" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-035" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-033"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="206"/><mxPoint x="920" y="322"/></Array></mxGeometry></mxCell><mxCell id="network-036" value='&lt;b&gt;&amp;lt;vault&amp;gt;.vault.azure.net&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Vaults reached publicly&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#737b84;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="400" height="64" as="geometry"/></mxCell><mxCell id="network-037" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="969" y="384" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-038" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#186575;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="network-009" target="network-036"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="206"/><mxPoint x="920" y="402"/></Array></mxGeometry></mxCell><mxCell id="network-039" value='&lt;b&gt;&amp;lt;rule&amp;gt;.&amp;lt;region&amp;gt;.ingest.monitor.azure.com&lt;/b&gt;&lt;br&gt;&lt;font color="#515963" style="font-size:11.5px"&gt;Audit sink, as the identity&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dcb783;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=6;fontFamily=Helvetica;fontSize=13;fontColor=#1c222a;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="400" height="64" as="geometry"/></mxCell><mxCell id="network-040" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Data_Collection_Rules.svg;" vertex="1" parent="1"><mxGeometry x="969" y="464" width="36" height="36" as="geometry"/></mxCell><mxCell id="network-041" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#804d0c;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#1c222a;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.2;exit