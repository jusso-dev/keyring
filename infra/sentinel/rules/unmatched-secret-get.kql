// A Key Vault SecretGet from Keyring's outbound addresses with no Keyring
// event to match it, joined on Key Vault's CorrelationId and Keyring's
// KvRequestId. A rollback reads the value and then writes it, so its event
// carries the later call's ID: a SecretGet with no ID match still counts as
// matched if the same person has a reveal, rollback or private key download
// event on the same vault and item within two minutes.
// Looks at Key Vault calls from one to two hours ago, so Keyring's events
// have had time to arrive.
// NOT YET CHECKED on a real vault: that Key Vault records Keyring's
// x-ms-client-request-id as CorrelationId. Off by default until the
// real-vault checklist row passes.
// Set by main.bicep: KeyVaultCalls, keyringIps
let Gets = KeyVaultCalls
| where TimeGenerated between (ago(2h) .. ago(1h))
| where CallerIpAddress in (keyringIps) and OperationName == "SecretGet"
| extend VaultName = tolower(tostring(split(ResourceId, "/")[-1]));
let Events = KeyringAudit_CL
| where TimeGenerated > ago(3h)
| where isnotempty(KvRequestId)
| project KvRequestId;
let ByPerson = KeyringAudit_CL
| where TimeGenerated > ago(3h)
| where Action in ("secret.reveal", "secret.rollback", "certificate.download_private_key")
| project EventTime = TimeGenerated, ActorObjectId, EventVault = tolower(Vault), ItemName;
Gets
| join kind=leftanti Events on $left.CorrelationId == $right.KvRequestId
| join kind=leftouter ByPerson on $left.CallerObjectId == $right.ActorObjectId, $left.VaultName == $right.EventVault, $left.Item == $right.ItemName
| summarize Near = countif(isnotempty(EventTime) and abs(datetime_diff('second', EventTime, TimeGenerated)) <= 120)
    by TimeGenerated, ResourceId, VaultName, Item, CallerObjectId, CallerIpAddress, CorrelationId
| where Near == 0
| project-away Near
