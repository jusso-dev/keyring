// Secret values read through Keyring: who, which vault and item, from where.
// The same question as "Secret values read" on Keyring's audit page, which
// reads Key Vault's log. Set who to part of a sign-in name to narrow it.
let who = "";
KeyringAudit_CL
| where Action == "secret.reveal"
| where isempty(who) or ActorUpn contains who or ActorObjectId =~ who
| project TimeGenerated, ActorUpn, ActorObjectId, Vault, ItemName, ItemVersion, Outcome, ReasonCode, ClientIp, KvRequestId, Reason, Ticket
| order by TimeGenerated desc
