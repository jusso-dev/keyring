# Copy this file to .env and fill in your own values. Never commit .env.

# Entra ID app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me

# Optional: scope for Keyring's own API. Defaults to api://<client ID>/access_as_user
# ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Public URL of this app, used for sign-in redirects
APP_BASE_URL=http://localhost:3000

# Required. At least 32 random characters. Make one with: openssl rand -base64 48
SESSION_SECRET=

# Set to true to allow permanent deletes (purge). Off by default.
KEYRING_ALLOW_PURGE=false

# Optional: address to listen on (default 0.0.0.0:3000)
# KEYRING_LISTEN=127.0.0.1:3000

# Optional: log level (error, warn, info, debug, trace). Default info.
# KEYRING_LOG_LEVEL=info
