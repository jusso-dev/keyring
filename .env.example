# Copy this file to .env and fill in your own values. Never commit .env.

# Entra ID app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me

# On Azure, you can use the app's managed identity instead of a client secret.
# Remove ENTRA_CLIENT_SECRET above and set the identity's client ID. Needs the
# federated credential from the README (step 2, option B). IDENTITY_ENDPOINT and
# IDENTITY_HEADER are set by App Service and Container Apps. The same identity
# is the only thing the audit sink writes with and email is sent as.
# KEYRING_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: the audit sink. Keyring's own audit events also go to a Log
# Analytics table, written as the managed identity above. See docs/deploy.md.
# KEYRING_AUDIT_INGESTION_ENDPOINT=https://<rule>.<region>.ingest.monitor.azure.com
# KEYRING_AUDIT_DCR_ID=dcr-00000000000000000000000000000000
# KEYRING_AUDIT_STREAM=Custom-KeyringAudit_CL
# KEYRING_AUDIT_REQUIRED=false

# Optional: email through Azure Communication Services, sent as the managed
# identity above, never with an access key. See docs/deploy.md, "Email".
# KEYRING_NOTIFY_ACS_ENDPOINT=https://<resource>.<geography>.communication.azure.com
# KEYRING_NOTIFY_SENDER=DoNotReply@<verified domain>
# KEYRING_NOTIFY_TYPES=expiry,access-requests,watched-reads,destructive,role-use,health
# KEYRING_NOTIFY_ADMINS=ops@example.com
# KEYRING_NOTIFY_ALLOWED_DOMAINS=example.com
# KEYRING_NOTIFY_RATE_PER_HOUR=20
# KEYRING_NOTIFY_AUDIT_RECIPIENTS=false
# Health notices: more than this many refused or denied requests from one
# person or address in 15 minutes emails the admins. Default 20.
# KEYRING_NOTIFY_BURST_THRESHOLD=20
# With ENTRA_CLIENT_SECRET only: its expiry date, so the admins get email at
# 30, 14, 7 and 1 days before it and once it has expired.
# KEYRING_CLIENT_SECRET_EXPIRES=2027-05-17

# Optional: scope for Keyring's own API. Defaults to api://<client ID>/access_as_user
# ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Public URL of this app, used for sign-in redirects
APP_BASE_URL=http://localhost:3000

# Required. At least 32 random characters. Make one with: openssl rand -base64 48
SESSION_SECRET=

# Set to true to allow permanent deletes (purge). Off by default.
KEYRING_ALLOW_PURGE=false

# Optional: address to listen on (default 0.0.0.0:3000)
# KEYRING_LISTEN=127.0.0.1:3000

# Optional: log level (error, warn, info, debug, trace). Default info.
# KEYRING_LOG_LEVEL=info

# Optional: log format, text (default) or json (one JSON object per line).
# KEYRING_LOG_FORMAT=text

# Optional: before a reveal, private key download, rollback or purge, ask
# for this Conditional Access authentication context (c1 to c99), and a
# sign-in no older than this many minutes (1 to 720). Both off by default.
# See docs/deploy.md, "Step-up before sensitive actions".
# KEYRING_STEP_UP_AUTH_CONTEXT=c1
# KEYRING_STEP_UP_MAX_AGE=15

# Optional: ask for a reason before a value is shown (reveal) or before
# anything is changed too (all). Off by default. With a pattern, a ticket
# that matches it as a whole is asked for as well. Shape only.
# See docs/deploy.md, "A reason before a value is shown".
# KEYRING_REQUIRE_REASON=reveal
# KEYRING_REASON_TICKET_PATTERN=(INC|CHG)[0-9]{7}

# Optional: a password policy for values typed into a Password or Login
# secret. Comma-separated parts, each off unless listed: min=N (characters,
# 1 to 256), upper, lower, digit, symbol, max-repeat=N (1 to 64) and common
# (refuse Keyring's built-in list of common passwords). Unset means no
# policy. Anything else stops Keyring starting. A Keyring control only.
# See docs/deploy.md, "Password policy".
# KEYRING_PASSWORD_POLICY=min=14,upper,lower,digit,symbol,max-repeat=3,common

# Optional: refuse to create or edit a secret, certificate or key without
# an owner tag (one email address), and skip import rows without one. Off
# by default. A Keyring control only: the Azure CLI and portal aren't
# limited. See README.md, "Owners".
# KEYRING_REQUIRE_OWNER=true

# Optional: how many proxies in front of Keyring add to X-Forwarded-For.
# 0 (default) ignores the header. 1 on App Service or Container Apps.
# KEYRING_TRUSTED_PROXY_HOPS=0
