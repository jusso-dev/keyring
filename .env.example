# Copy this file to .env and fill in your own values. Never commit .env.

# Entra ID app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me

# On Azure, you can use the app's managed identity instead of a client secret.
# Remove ENTRA_CLIENT_SECRET above and set the identity's client ID. Needs the
# federated credential from the README (step 2, option B). IDENTITY_ENDPOINT and
# IDENTITY_HEADER are set by App Service and Container Apps. The same identity
# is the only thing the audit sink writes with.
# KEYRING_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: the audit sink. Keyring's own audit events also go to a Log
# Analytics table, written as the managed identity above. See docs/deploy.md.
# KEYRING_AUDIT_INGESTION_ENDPOINT=https://<rule>.<region>.ingest.monitor.azure.com
# KEYRING_AUDIT_DCR_ID=dcr-00000000000000000000000000000000
# KEYRING_AUDIT_STREAM=Custom-KeyringAudit_CL
# KEYRING_AUDIT_REQUIRED=false

# Optional: scope for Keyring's own API. Defaults to api://<client ID>/access_as_user
# ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Public URL of this app, used for sign-in redirects
APP_BASE_URL=http://localhost:3000

# Required. At least 32 random characters. Make one with: openssl rand -base64 48
SESSION_SECRET=

# Set to true to allow permanent deletes (purge). Off by default.
KEYRING_ALLOW_PURGE=false

# Optional: address to listen on (default 0.0.0.0:3000)
# KEYRING_LISTEN=127.0.0.1:3000

# Optional: log level (error, warn, info, debug, trace). Default info.
# KEYRING_LOG_LEVEL=info

# Optional: log format, text (default) or json (one JSON object per line).
# KEYRING_LOG_FORMAT=text

# Optional: how many proxies in front of Keyring add to X-Forwarded-For.
# 0 (default) ignores the header. 1 on App Service or Container Apps.
# KEYRING_TRUSTED_PROXY_HOPS=0
