# Copy to .env.local and fill in. Never commit real values.

# Entra ID tenant (directory) ID
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration client (application) ID
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret for the app registration. Keep it out of the repo.
ENTRA_CLIENT_SECRET=replace-me
# Public URL of this app, used for redirects
APP_BASE_URL=http://localhost:3000
# At least 32 random characters. For example: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Set to true to allow permanent deletes (purge). Off by default.
KEYRING_ALLOW_PURGE=false
