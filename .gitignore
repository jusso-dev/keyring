/target
.env
.env.*
!.env.example
.DS_Store

# Filled-in Bicep parameters hold tenant IDs, names and addresses.
*.bicepparam
!*.example.bicepparam

# Terraform state, caches, plans and filled-in variable files.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
crash.*.log

# Packer filled-in variable files and manifests.
*.auto.pkrvars.hcl
*.pkrvars.hcl
!*.pkrvars.hcl.example
packer-manifest.json

# The docs site in website/: never commit its packages or build output.
website/node_modules
website/build
website/.docusaurus

# Python bytecode from helper scripts in tools/.
__pycache__/
*.pyc
